# Config files.
src/backend-api/config/*.json
src/backend-player/config/*.json
**/server/config/*.json

# Temporary deploy files.
src/**/*.zip
src/deploy.zip
src/deploy

# npm / Angular / esbuild files.
node_modules
.angular
*.esbuild-meta.json

# Other files.
*.bak

# Output of a plain tsc run (the box runs the esbuild bundle, see src/deploy)
src/backend-api/build/


__pycache__/
*.pyc
.idea

# Cover cache the backend-api writes next to its cwd when run locally (on the box it lies in the install folder).
src/backend-api/cache/
# rss covers the backend-api writes next to its sources when run locally (serverDir/www; on the box that is the install folder)
src/backend-api/src/www/
