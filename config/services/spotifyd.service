# DEPRECATED 2026-09-20: spotifyd was replaced by librespot; the update script only stops and disables this unit, nothing installs it.
# Kept for reference; nothing in MuPiBox calls it. Safe to delete.
[Unit]
Description=A spotify playing daemon
Documentation=https://github.com/Spotifyd/spotifyd
Wants=sound.target
After=sound.target
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/spotifyd --no-daemon --config-path /etc/spotifyd/spotifyd.conf --initial-volume 100
Restart=always
RestartSec=12

[Install]
WantedBy=default.target
