[Unit]
# Never give up (StartLimitIntervalSec=0), but retry slowly (RestartSec >= 60): with a start
# limit the service stayed dead for good after a few quick failures - e.g. a boot without WiFi -
# until the next reboot; retrying every 10 s filled the journal (librespot 325x in an hour).
StartLimitIntervalSec=0
Description=A spotify connect device
Documentation=https://github.com/librespot-org/librespot/wiki/Options
Wants=sound.target
After=sound.target
Wants=network-online.target
After=network-online.target
Wants=pulseaudio.service
After=pulseaudio.service

[Service]
# Switched off in the app (spotify.connectOff, e.g. while Spotify refuses Connect logins): the unit is skipped, whoever
# starts it (boot, update, a script), instead of failing and retrying every minute
ExecCondition=/bin/sh -c '[ "$(/usr/bin/jq -r ".spotify.connectOff // false" /etc/mupibox/mupiboxconfig.json 2>/dev/null)" != "true" ]'
ExecStart=/bin/bash -c 'source /etc/librespot/env-librespot && /usr/bin/librespot -q'
Restart=always
RestartSec=60
# Phase 13b (B4): bound restart attempts. Without a burst limit a
# repeatedly-failing token (revoked, network outage) caused journal-log
# spam and SD-wear. 5 attempts per 10 min is enough to recover from a
# transient connection blip without hammering systemd / journald.

[Install]
WantedBy=default.target
